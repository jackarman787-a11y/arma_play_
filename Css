:root {
    --bg-color: #121212;
    --card-bg: #181818;
    --primary-green: #1db954;
    --text-main: #ffffff;
    --text-sub: #b3b3b3;
}

body {
    background-color: var(--bg-color);
    color: var(--text-main);
    font-family: 'Arial', sans-serif;
    margin: 0;
    padding-bottom: 150px; /* Space for player and nav */
}

/* Header */
header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px;
}

h2 span { color: var(--primary-green); }

/* Grid Layout */
.grid-container {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    padding: 15px;
}

.card {
    background: var(--card-bg);
    border-radius: 8px;
    overflow: hidden;
    padding: 10px;
}

.card img {
    width: 100%;
    border-radius: 5px;
}

/* Bottom Navigation */
.bottom-nav {
    position: fixed;
    bottom: 0;
    width: 100%;
    background: #000;
    display: flex;
    justify-content: space-around;
    padding: 10px 0;
    border-top: 1px solid #333;
}

.bottom-nav a {
    color: var(--text-sub);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 12px;
}

.bottom-nav a.active { color: var(--text-main); }

/* Music Player Bar */
.music-player {
    position: fixed;
    bottom: 60px; /* Above nav */
    left: 10px;
    right: 10px;
    background: var(--primary-green);
    color: black;
    padding: 10px;
    border-radius: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: bold;
}
